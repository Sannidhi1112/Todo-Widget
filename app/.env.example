# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
# The anon key is a public/publishable key -- it's safe to ship in the app,
# access to data is enforced by the Row Level Security policies in
# supabase/schema.sql, not by keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
